NODE_ENV=development
PORT=5000

# From Supabase dashboard: Project Settings -> Database -> Connection string
# (use the "Session pooler" or direct connection string, not the pgbouncer
# transaction-mode one — migrations need a persistent session)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# From Supabase dashboard: Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
# Service role key bypasses RLS entirely — backend only, NEVER sent to the
# frontend, NEVER committed. This is what lets our admin endpoints read
# login_attempts/audit_logs/all profiles despite RLS blocking normal users.
SUPABASE_SERVICE_ROLE_KEY=

FRONTEND_URL=http://localhost:5173
